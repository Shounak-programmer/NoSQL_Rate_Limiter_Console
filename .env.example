# ==============================================================================
# Environment Configuration Template — MongoDB Rate Limiter
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# MongoDB Connection URI (Local mongod or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=rate_limiter
MONGO_TIMEOUT_MS=5000

# Default Rate Limiting Policy
# Algorithms: token_bucket | sliding_window | fixed_window
RATE_LIMIT_ALGORITHM=token_bucket
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REFILL_RATE=1.0

# Server Options
HOST=0.0.0.0
PORT=8000
